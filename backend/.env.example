# Aya assistant — environment template (blank values only, never commit secrets)
# Copy to .env on the server that runs the assistant routes.

# Meta Model API (https://dev.meta.ai → Dashboard → API keys)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Model IDs (defaults live in lib/assistant/config.js)
MODEL_BRAIN=muse-spark-1.3
# Optional: model used once if MODEL_BRAIN 404s (stale/retired id).
# Keep it different from MODEL_BRAIN so one bad id leaves a retry path.
MODEL_BRAIN_FALLBACK=muse-spark-1.2
MODEL_VISION=muse-spark-1.3
MODEL_DEEP=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0

# Speech-to-text (defaults to the Meta key/base when unset)
STT_API_KEY=
STT_API_BASE=
STT_MODEL=muse-voice-transcribe-1.0

# Reasoning + reliability
META_REASONING_EFFORT=low
META_TIMEOUT_MS=45000
META_COOLDOWN_MS=60000
# Legacy /api/assistant provider mode. /api/ai always calls Meta directly.
DEMO_MODE=auto

# Aya Shelfie: canned fallback shelf. OFF unless explicitly "true".
SHELFIE_FALLBACK=false

# Voice output. Default TTS_MODE=device uses the phone's own voice, because
# Hugging Face retired the hosted path for facebook/mms-tts-* (see AI_AGENT.md).
# Set TTS_MODE=mms only when a reachable Meta MMS endpoint is configured.
# The voice follows the speaker's own language: eng/yor/hau/ibo, detected
# from the /transcribe text. Override one voice model without touching code:
TTS_MODE=device
HF_INFERENCE_BASE=https://router.huggingface.co/hf-inference/models
HF_API_KEY=
MMS_TTS_MODEL_ENG=facebook/mms-tts-eng
MMS_TTS_MODEL_YOR=facebook/mms-tts-yor
MMS_TTS_MODEL_HAU=facebook/mms-tts-hau
MMS_TTS_MODEL_IBO=facebook/mms-tts-ibo
TTS_TIMEOUT_MS=30000
TTS_MAX_CHARS=500

# Agentic fallback brain (Muse Glimmer 30B, hosted via Together AI)
TOGETHER_API_KEY=
TOGETHER_API_BASE=https://api.together.xyz/v1
GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
GLIMMER_TIMEOUT_MS=60000
# GLIMMER_FIRST=true   # put Glimmer first to demo the brains side by side

# Background cleanup (commercial pay-per-call matting endpoint; see
# lib/assistant/clean.js — RMBG weights are CC BY-NC, do NOT use them here)
BG_API_URL=
BG_API_KEY=
BG_MODEL=bg-matting
BG_TIMEOUT_MS=45000

# ── AI agent (/api/ai) ──────────────────────────────────────────────────────
# Public origin used when the agent builds a Google sign-in URL. Defaults to
# https://salmart.onrender.com in production, http://localhost:3000 otherwise.
APP_BASE_URL=

# Winston level for services/logger.js (writes logs/ai.log). info in production.
AI_LOG_LEVEL=info

# Google sign-in — the agent reports Google as supported only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native Google sign-in web client id (used by the host app.js auth route).
GOOGLE_MOBILE_WEB_CLIENT_ID=

# Host server values already configured on the deployment. Required by the
# AI conversation/action/form-patch models and the JWT middleware.
MONGO_URI=
JWT_SECRET=

VERBOSE=true
