{
  "name": "backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node app.js",
    "dev": "nodemon app.js",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "test": "node --test \"tests/**/*.test.js\"",
    "eval:ai": "node scripts/ai-eval.js",
    "build": "npm install --legacy-peer-deps --ignore-scripts && npm rebuild mongodb --build-from-source",
    "generate-ssl": "mkdir -p ssl && openssl req -nodes -new -x509 -keyout ssl/key.pem -out ssl/cert.pem -subj '/CN=localhost'"
  },
  "engines": {
    "node": "22.x",
    "npm": "9.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@capacitor/android": "^7.4.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hotwired/turbo": "^8.0.13",
    "@img/sharp-wasm32": "^0.35.2",
    "@resvg/resvg-js": "^2.6.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "ajv": "^8.20.0",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "blurhash": "^2.0.5",
    "bson": "^6.10.3",
    "bullmq": "^5.81.5",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "debug": "^4.4.1",
    "dotenv": "^16.4.7",
    "expo": "^53.0.20",
    "expo-notifications": "^0.31.4",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.10.0",
    "jimp": "^0.16.1",
    "jsonwebtoken": "^9.0.2",
