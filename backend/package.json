    "nodemon": "^3.1.9",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "paystack": "^2.0.1",
    "paystack-api": "^2.0.6",
    "pdfkit": "^0.16.0",
    "react-native-webview": "^13.13.5",
    "redis": "^5.12.1",
    "resend": "^6.1.0",
    "rimraf": "^6.0.1",
    "sanitize-html": "^2.17.0",
    "saslprep": "^1.0.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "svg2img": "^1.0.0-beta.2",
