+/* ------------------------------------------------------------------ */
+/* Provider 3: Meta Model API (Muse Spark / Muse Wonder)              */
+/* Same OpenAI-style tool loop as Groq, so tools and app actions are  */
+/* identical. Meta is tried first when a key is configured.           */
+/* ------------------------------------------------------------------ */
+async function runMetaAgent(convo, userId, toolResults) {
+  const messages = [{ role: 'system', content: buildSystemPrompt(userId, toolResults.ctx) }, ...convo];
+  for (let step = 0; step < MAX_STEPS; step++) {
+    const { raw } = await metaChat({
+      messages,
+      tools: GROQ_TOOLS,
+      toolChoice: 'auto',
+      temperature: 0.3,
+      maxTokens: 2400,
+    });
+    const msg = raw?.choices?.[0]?.message || {};
+    const calls = msg.tool_calls || [];
+    if (!calls.length) return (msg.content || '').trim() || 'Done.';
+    messages.push({ role: 'assistant', content: msg.content || null, tool_calls: calls });
+    for (const tc of calls) {
+      let args = {};
+      try { args = JSON.parse(tc.function?.arguments || '{}'); } catch (_) {}
+      const out = await runTool(tc.function?.name, args, userId, toolResults);
+      messages.push({ role: 'tool', tool_call_id: tc.id, content: JSON.stringify(out) });
