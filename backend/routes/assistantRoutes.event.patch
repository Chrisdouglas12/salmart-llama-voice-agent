+  });
+  return data;
+}
+
+/* Gemini returns raw 16-bit PCM; wrap it in a WAV header so the phone can
+ * play the bytes directly with no server-side encoding step. */
+function pcmToWavBase64(pcmBase64, { sampleRate = 24000, channels = 1 } = {}) {
+  const pcm = Buffer.from(pcmBase64, 'base64');
+  const header = Buffer.alloc(44);
+  header.write('RIFF', 0);
+  header.writeUInt32LE(36 + pcm.length, 4);
+  header.write('WAVE', 8);
+  header.write('fmt ', 12);
+  header.writeUInt32LE(16, 16);
+  header.writeUInt16LE(1, 20);
+  header.writeUInt16LE(channels, 22);
+  header.writeUInt32LE(sampleRate, 24);
+  header.writeUInt32LE(sampleRate * channels * 2, 28);
+  header.writeUInt16LE(channels * 2, 32);
+  header.writeUInt16LE(16, 34);
+  header.write('data', 36);
+  header.writeUInt32LE(pcm.length, 40);
+  return Buffer.concat([header, pcm]).toString('base64');
+}
+
+/* Voice output for spoken replies. Throws when Gemini has no key or returns
+ * no audio — the route turns that into { success:false } and the app falls
+ * back to the phone's own TTS. */
+async function geminiTTS(text) {
+  const clean = String(text || '').replace(/\s+/g, ' ').trim().slice(0, TTS_MAX_CHARS);
+  if (!clean) throw new Error('empty_text');
+  if (!genAI) throw new Error('tts_not_configured');
+  const res = await withTimeout(genAI.models.generateContent({
+    model: TTS_MODEL,
+    contents: [{ role: 'user', parts: [{ text: `Say warmly, at a natural pace: ${clean}` }] }],
+    config: {
+      responseModalities: ['AUDIO'],
+      speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: TTS_VOICE } } },
+    },
+  }), TTS_TIMEOUT_MS, 'Gemini TTS');
+  const parts = res.candidates?.[0]?.content?.parts || [];
+  const audio = parts.find(p => p.inlineData && p.inlineData.data);
+  if (!audio) throw new Error('no_audio_part');
+  const mime = String(audio.inlineData.mimeType || '');
+  const rate = Number((mime.match(/rate=(\d+)/) || [])[1]) || 24000;
+  return {
+    audio: pcmToWavBase64(audio.inlineData.data, { sampleRate: rate }),
+    mimeType: 'audio/wav',
+    provider: 'gemini',
+    model: TTS_MODEL,
+    voice: TTS_VOICE,
+  };
+}
