+/**
+ * Remove an assistant instruction prefix that must never be spoken.
+ *
+ * Models sometimes echo the framing they were given, e.g.
+ *   "Next, say: How many do you have?"
+ *   "Now ask: What price?"
+ *   "Say: Pick the photo"
+ * The buyer must hear only the words meant for them. This strips a leading
+ * meta label and the same label after a sentence boundary.
+ */
+export function stripReplyPrefix(text) {
+  let out = String(text == null ? '' : text).trim();
+  if (!out) return '';
+
+  const LEADING = /^(?:(?:next|now|then)\s*,?\s*(?:say|ask|reply|tell them)|say|ask|reply|assistant)\s*[:,-]\s*/i;
+  // Run twice so "Next, say: Say: ..." also collapses cleanly.
+  for (let i = 0; i < 2; i += 1) {
+    const next = out.replace(LEADING, '').trim();
+    if (next === out) break;
+    out = next;
+  }
+
+  out = out
+    .replace(/([.!?]\s+)(?:next|now|then)\s*,?\s*(?:say|ask|reply|tell them)\s*:\s*/gi, '$1')
+    .replace(/([.!?]\s+)next\s*:\s*/gi, '$1')
+    .replace(/\s+/g, ' ')
+    .trim();
+
+  return out;
+}
