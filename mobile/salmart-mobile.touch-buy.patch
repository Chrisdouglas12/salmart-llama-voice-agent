--- /dev/null
+++ b/src/ai/listingOutcome.js
@@ -0,0 +1,43 @@
+/**
+ * Listing post outcome passed to the next AI turn.
+ *
+ * CreateAdScreen knows why a post failed (validation message, offline,
+ * server rejection). Only the fixed outcome code is passed on, never raw
+ * server text, so the assistant can explain the failure and name the fix
+ * using a real code.
+ *
+ * The value is kept in memory because it is only useful for the next sentence.
+ */
+
+// Must match LISTING_GUIDANCE in lib/assistant/sellingFlow.js on the backend.
+const VALID = new Set([
+  'photo_missing',
+  'price_invalid',
+  'quantity_invalid',
+  'field_missing',
+  'content_blocked',
+  'network_unavailable',
+  'publish_failed',
+]);
+
+let pending = null;
+
+/** Record the code for the next AI turn. Unknown codes are ignored. */
+export function reportListingOutcome(code) {
+  const key = String(code || '').trim().toLowerCase();
+  if (VALID.has(key)) pending = key;
+}
+
+/** Read and clear the pending code. */
+export function takeListingOutcome() {
+  const value = pending;
+  pending = null;
+  return value;
+}
+
+/** Inspect without clearing. Used by tests and debugging. */
+export function peekListingOutcome() {
+  return pending;
+}
+
+export const LISTING_OUTCOME_CODES = Array.from(VALID);
diff --git a/src/ai/liveScreen.js b/src/ai/liveScreen.js
new file mode 100644
index 0000000..b03acf7
--- /dev/null
+++ b/src/ai/liveScreen.js
@@ -0,0 +1,26 @@
+/**
+ * The route the user is actually looking at.
+ *
+ * AIProvider sits above every screen, so it cannot read the top screen's route
+ * params from the screen itself. A tiny non-rendering mirror (NavMirror in
+ * AIContext) writes the live route here on every navigation, and every turn
+ * reads it at send time. Keeping this outside React state means navigation
+ * never re-renders the AI provider or its consumers.
+ *
+ * Only the route name and its params are kept; the params object is already the
+ * one the navigation stack owns, so nothing is copied or serialized per turn.
+ */
+
+let live = { name: null, params: {}, panel: null };
+
+export function setLiveScreen(name, params, panel) {
+  live = {
+    name: name ? String(name).slice(0, 120) : null,
+    params: params && typeof params === 'object' ? params : {},
+    panel: panel ? String(panel).slice(0, 120) : null,
+  };
+}
+
+export function getLiveScreen() {
+  return live;
+}
